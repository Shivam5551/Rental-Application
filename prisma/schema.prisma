generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String     @id @default(uuid())
  name              String
  email             String     @unique
  password          String?
  image             String?
  bankaccountnumber String?
  bankifscnumber    String?
  properties        Property[]
  inquiries         Inquiry[]
  reviews           Review[]
  bookings          Booking[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  provider          Provider
  payments          Payment[]
  token             Token[]
  deletedAt         DateTime?

  @@index([email])
}

model Property {
  id          String @id @default(uuid())
  title       String
  description String
  price       Int
  discount    Int    @default(0)

  address    String
  city       String
  state      String
  country    String @default("India")
  postalCode String
  latitude   Float?
  longitude  Float?

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?
  userId        String
  verified      Boolean         @default(false)
  petfriendly   Boolean         @default(false)
  area          Int
  beds          Int
  baths         Int
  firesafety    Boolean         @default(false)
  showcaseimage String
  user          User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  images        PropertyImage[]
  bookings      Booking[]
  inquiries     Inquiry[]
  reviews       Review[]

  @@index([userId])
  @@index([city])
  @@index([state])
  @@index([country])
}

model PropertyImage {
  id         String   @id @default(uuid())
  url        String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String

  @@index([propertyId])
}

model Inquiry {
  id         String   @id @default(uuid())
  message    String
  createdAt  DateTime @default(now())
  userId     String
  propertyId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Review {
  id         String   @id @default(uuid())
  rating     Int
  comment    String
  createdAt  DateTime @default(now())
  userId     String
  propertyId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Booking {
  id         String        @id @default(uuid())
  startDate  DateTime
  endDate    DateTime
  totalPrice Int
  createdAt  DateTime      @default(now())
  userId     String
  propertyId String
  orderId    String        @unique
  verified   Boolean       @default(false)
  status     BookingStatus @default(PENDING)
  user       User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  property   Property      @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  payment    Payment[]

  @@unique([userId, propertyId, startDate, orderId])
}

model Payment {
  id                String        @id @default(uuid())
  amount            Int
  currency          String        @default("INR")
  status            PaymentStatus
  razorpayOrderId   String        @unique
  razorpayPaymentId String?
  razorpaySignature String?
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  bookingId         String
  booking           Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([userId])
  @@index([razorpayOrderId])
}

model Token {
  id               String   @id @default(cuid())
  userId           String   @unique
  refreshTokenHash String
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WebhookEvent {
  id        String   @id @default(uuid())
  eventType String
  payload   Json
  processed Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum PaymentStatus {
  PENDING
  CAPTURED
  FAILED
  REFUNDED
}

enum Provider {
  Google
  Email
}

enum BookingStatus {
  PENDING
  CONFIRMED
  EXPIRED
  CANCELLED
}
